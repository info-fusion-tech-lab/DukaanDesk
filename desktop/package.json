{
  "name": "dukaandesk-desktop",
  "version": "2.0.0",
  "private": true,
  "description": "Free offline desktop shop management application",
  "author": "Info Fusion Tech Lab",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.infofusion.shopmanagementsystem",
    "productName": "DukaanDesk",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/store.ico",
        "to": "app-icon.ico"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/store.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/store.ico",
      "uninstallerIcon": "assets/store.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "assets/store.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "icon": "assets/store.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
